APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BANK_NAME="Bank Mini Sekolah"
BANK_SCHOOL="SMK"
BANK_MIN_BALANCE=10000
BANK_PIN_MAX_ATTEMPTS=3
BANK_PIN_LOCK_MINUTES=15
BANK_WITHDRAWAL_AUTH_PENDING_SECONDS=120
BANK_WITHDRAWAL_AUTH_APPROVED_SECONDS=120
SANCTUM_EXPIRATION=480

# Customer app sessions (minutes; default 30 days). Staff tokens use SANCTUM_EXPIRATION.
CUSTOMER_SESSION_MINUTES=43200


# Firebase Authentication (customer login). FIREBASE_CREDENTIALS is the path to the
# service account JSON (relative to the project root or absolute), e.g.
# storage/app/private/firebase-credentials.json. Never commit that file.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
FIREBASE_ALLOWED_PROVIDERS=password,google.com
# Local development against the Firebase Auth emulator (unset in production):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
